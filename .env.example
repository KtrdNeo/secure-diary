# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings -> API in the Supabase dashboard).
#
# The app works fully offline with these left blank - sync is optional
# and purely additive. Setup steps:
#   1. Create a project at https://supabase.com
#   2. In the SQL editor, run supabase/schema.sql from this repo
#   3. Copy your Project URL and anon/public key below
#   4. Restart `npm run dev`
#
# The anon key is safe to expose client-side by design (Supabase's Row
# Level Security policies, also defined in supabase/schema.sql, are what
# actually protect the data - not keeping this key secret). It is NOT
# your diary passphrase, and your diary passphrase is never sent here or
# anywhere else - see CHECKPOINT_SUMMARY.md if that distinction isn't
# clear.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
